{
  "name": "@viglet/turing-flow-dsl",
  "version": "2026.3.3",
  "description": "TypeScript DSL for Viglet Turing ES chat flows — author flows as typed source, transpile to the editor's JSON wire format. Catches enum typos (tone, guardrail, trigger) at compile time.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "turing-flow-dsl": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/test/transpile.test.js dist/test/deploy.test.js dist/test/chaotic-chatflow.test.js"
  },
  "keywords": [
    "turing",
    "chat-flow",
    "dsl",
    "typescript",
    "type-safe"
  ],
  "author": "Viglet",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openviglet/turing.git",
    "directory": "frontend/packages/flow-dsl"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3"
  }
}
