{
  "name": "@viglet/turing-react-sdk",
  "version": "2026.3.6",
  "description": "React SDK for Viglet Turing ES - Headless hooks + UI components for enterprise search",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "size": "node ../../scripts/check-size.mjs",
    "prepublishOnly": "npm run build && npm run size",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "turing",
    "react",
    "search",
    "semantic-navigation",
    "headless",
    "hooks",
    "enterprise-search",
    "sdk"
  ],
  "author": "Viglet",
  "license": "Apache-2.0",
  "dependencies": {
    "@viglet/turing-sdk": "workspace:*",
    "@viglet/turing-react-ui": "workspace:*"
  },
  "peerDependencies": {
    "axios": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-markdown": "^9.0.0 || ^10.0.0",
    "@terrastruct/d2": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "react-markdown": {
      "optional": true
    },
    "@terrastruct/d2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-links": "^10.5.1",
    "@storybook/react": "^10.5.1",
    "@storybook/react-vite": "^10.5.1",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.0.3",
    "axios": "^1.18.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "storybook": "^10.5.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.16",
    "@storybook/addon-docs": "^10.5.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openviglet/turing.git",
    "directory": "frontend/packages/react-sdk"
  },
  "files": [
    "dist/**/*"
  ],
  "sizeBudget": {
    "exclude": [
      "stories/",
      "__mocks__/",
      "__tests__/"
    ],
    "strict": false,
    "total": 92160
  }
}
