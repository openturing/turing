{
  "name": "@viglet/turing-frontend",
  "private": true,
  "version": "2026.2.10",
  "packageManager": "npm@11.6.2",
  "description": "Viglet Turing ES — unified JavaScript monorepo (dashboard, SDK, marketplace apps)",
  "workspaces": [
    "apps/turing-app",
    "apps/marketplace/mythical-creatures",
    "apps/marketplace/space-missions",
    "apps/marketplace/vinyl-records",
    "packages/react-sdk",
    "packages/shared-types"
  ],
  "scripts": {
    "postinstall": "node scripts/workspace-status.mjs",
    "bump:patch": "npm version patch --workspaces --include-workspace-root",
    "bump:minor": "npm version minor --workspaces --include-workspace-root",
    "compile": "npm install --no-audit --no-fund && turbo run compile --filter=turing-react && node scripts/build-status.mjs",
    "compile:deps": "npm install --no-audit --no-fund",
    "build": "turbo run build && node scripts/build-status.mjs",
    "build:sdk": "turbo run build --filter=@viglet/turing-react-sdk && node scripts/build-status.mjs",
    "build:app": "turbo run compile --filter=turing-react && node scripts/build-status.mjs",
    "build:marketplace": "turbo run compile --filter=\"./apps/marketplace/*\" && node scripts/build-status.mjs",
    "dev:app": "turbo run dev --filter=turing-react",
    "lint": "turbo run lint",
    "clean": "rimraf \"**/node_modules\" \"**/dist\" \"**/build\""
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
