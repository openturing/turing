{
  "name": "@viglet/turing-frontend",
  "private": true,
  "version": "2026.2.27",
  "packageManager": "pnpm@10.33.0",
  "description": "Viglet Turing ES — unified JavaScript monorepo (dashboard, SDK, marketplace apps)",
  "scripts": {
    "postinstall": "node scripts/workspace-status.mjs",
    "bump:patch": "pnpm -r --include-workspace-root exec -- npm version patch --no-git-tag-version",
    "bump:minor": "pnpm -r --include-workspace-root exec -- npm version minor --no-git-tag-version",
    "build": "pnpm install && turbo run build && node scripts/build-status.mjs",
    "build:sdk": "turbo run build --filter=@viglet/turing-react-sdk && node scripts/build-status.mjs",
    "build:app": "turbo run build --filter=turing-app && node scripts/build-status.mjs",
    "build:marketplace": "turbo run build --filter=\"./apps/marketplace/*\" && node scripts/build-status.mjs",
    "build-storybook:react-sdk": "turbo run build-storybook --filter=@viglet/turing-react-sdk",
    "package:marketplace": "pnpm --filter @viglet/turing-react-sdk run build && pnpm --filter=\"./apps/marketplace/*\" run package",
    "dev:app": "turbo run dev --filter=turing-app",
    "dev:mythical-creatures": "turbo run dev --filter=turing-example-mythical-creatures",
    "dev:space-missions": "turbo run dev --filter=turing-example-space-missions",
    "dev:vinyl-records": "turbo run dev --filter=turing-example-vinyl-records",
    "storybook:react-sdk": "turbo run storybook --filter=@viglet/turing-react-sdk",
    "lint": "turbo run lint",
    "clean": "rimraf \"**/node_modules\" \"**/dist\" \"**/build\""
  },
  "devDependencies": {
    "turbo": "^2.9.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core",
      "@tailwindcss/oxide"
    ]
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
