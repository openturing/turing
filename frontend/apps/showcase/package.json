{
  "name": "turing-showcase",
  "private": true,
  "version": "2026.3.1",
  "type": "module",
  "description": "Atlas Store — the Viglet Turing ES reference showcase app (stresses the maximum platform surface: typed catalog, faceted search, RAG chat, agents, skills, creative bets).",
  "scripts": {
    "dev": "vite",
    "gen-catalog": "node gen-catalog.mjs",
