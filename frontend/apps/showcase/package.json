{
  "name": "turing-showcase",
  "private": true,
  "version": "2026.3.1",
  "type": "module",
  "description": "Atlas Store \u2014 the Viglet Turing ES reference showcase app (stresses the maximum platform surface: typed catalog, faceted search, RAG chat, agents, skills, creative bets).",
  "scripts": {
    "dev": "vite",
    "gen-catalog": "node gen-catalog.mjs",
    "gen-manifest": "node gen-manifest.mjs",
    "zip": "node zip-dist.mjs",
    "package": "npm run build && npm run zip",
    "preview": "vite preview",
    "build": "npm run gen-catalog && npm run gen-manifest && tsc -b && vite build && node gen-manifest.mjs --dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tabler/icons-react": "^3.49.0",
    "@terrastruct/d2": "^0.1.33",
    "@viglet/turing-react-sdk": "workspace:*",
    "@viglet/turing-react-ui": "workspace:*",
    "@viglet/turing-sdk": "workspace:*",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@viglet/eslint-config": "workspace:*",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  }
}
