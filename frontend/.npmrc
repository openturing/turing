# pnpm settings for the Turing frontend monorepo.

# Hoist every transitive dep to the top-level node_modules so legacy code that
# relies on phantom imports (e.g. @module-federation/runtime via enhanced) keeps
# working. Loses pnpm's strictness but preserves the main benefit of the move:
# correct resolution of platform-specific optional natives (@tailwindcss/oxide
# on Linux CI, esbuild binaries, etc.). Tighten later by moving phantom imports
# to explicit deps and flipping this off.
shamefully-hoist=true

# CI/builds should never block on a missing engines entry. Keep 'engines'
# advisory only.
engine-strict=false

# pnpm 11 prompts before purging node_modules when the store layout changes
# (e.g. after a major pnpm upgrade) and aborts under a non-TTY build like the
# frontend-maven-plugin. Skip the prompt so installs are non-interactive.
confirm-modules-purge=false
