# syntax=docker/dockerfile:1.7
#
# Multi-stage Dockerfile for deploying `turing-app` as a Web Service on Koyeb
# (https://www.koyeb.com/docs/build-and-deploy/build-from-git).
#
# Three stages:
#   1. node-builder  — installs npm deps, compiles the React SPA
#   2. java-builder  — Maven build (backend), skipping npm (SPA copied in)
#   3. runtime       — JRE-only image with the fat jar
#
# Build locally for testing:
#   docker build -f Dockerfile.koyeb -t turing-koyeb .
#   docker run --rm -p 8080:8080 -e PORT=8080 turing-koyeb
#

# ──────────────────────────────────────────────────────────────────────────
# Stage 1 — Build the React SPA
# ──────────────────────────────────────────────────────────────────────────
FROM node:24-slim AS node-builder

WORKDIR /build

# turing-react-sdk is referenced by vite.config.ts resolve.alias
# (../turing-react-sdk/src/index.ts) — only sources are needed.
COPY turing-react-sdk/src          turing-react-sdk/src
COPY turing-react-sdk/package.json turing-react-sdk/
COPY turing-react-sdk/tsconfig.json turing-react-sdk/

# Copy frontend sources (without node_modules — npm ci will install them)
COPY turing-react/package.json      turing-react/
COPY turing-react/package-lock.json turing-react/

WORKDIR /build/turing-react

# Install deps — same resilient pattern used by the project's compile:deps
# script. npm ci may fail if the lockfile was generated by a different npm
# minor version, so fall back to npm install.
RUN npm ci --no-audit --no-fund \
    || npm install --no-audit --no-fund

# Copy the rest of the frontend sources (overwriting package.json is fine).
COPY turing-react/ /build/turing-react/

# tsc + vite build → output lands in ../turing-app/src/main/resources/public/
# (per vite.config.ts outDir). Create the target dir so Vite doesn't fail.
RUN mkdir -p /build/turing-app/src/main/resources/public \
    && npx tsc -b \
    && npx vite build

# ──────────────────────────────────────────────────────────────────────────
# Stage 2 — Build the Spring Boot fat jar (backend only)
# ──────────────────────────────────────────────────────────────────────────
FROM maven:3.9-eclipse-temurin-21 AS java-builder

WORKDIR /build

# 1) Copy only the POMs first so Maven can cache dependencies.
COPY pom.xml ./
COPY turing-commons/pom.xml  turing-commons/
COPY turing-spring/pom.xml   turing-spring/
COPY turing-java-sdk/pom.xml turing-java-sdk/
COPY turing-utils/pom.xml    turing-utils/
COPY turing-app/pom.xml      turing-app/

RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -pl turing-app -am dependency:go-offline -DskipTests -Dskip.installnodenpm=true -Dskip.npm=true || true

# 2) Copy Java sources + .git (for git-commit-id-plugin manifest version).
COPY .git            .git
COPY turing-commons  turing-commons
COPY turing-spring   turing-spring
COPY turing-java-sdk turing-java-sdk
COPY turing-utils    turing-utils
COPY turing-app      turing-app

# 3) Copy the compiled SPA from the node-builder stage into the Spring Boot
#    resources directory so it gets packaged into the fat jar.
COPY --from=node-builder /build/turing-app/src/main/resources/public/ \
     turing-app/src/main/resources/public/

# 4) Build. -Dskip.npm=true skips the frontend-maven-plugin entirely.
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -pl turing-app -am package -DskipTests -Dskip.installnodenpm=true -Dskip.npm=true

RUN cp turing-app/target/viglet-turing.jar /build/app.jar

# ──────────────────────────────────────────────────────────────────────────
# Stage 3 — Minimal runtime
# ──────────────────────────────────────────────────────────────────────────
FROM eclipse-temurin:21-jre

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# /app/store is mounted as a Koyeb Persistent Volume (turing-vol).
# The mkdir + chown ensures the dirs exist even without the volume.
RUN useradd --system --create-home --uid 1001 --gid 0 java \
    && mkdir -p /app /app/store/db /app/store/logs /app/store/queue /app/store/assets /app/models \
    && chown -R java:0 /app

WORKDIR /app

COPY --from=java-builder --chown=java:0 /build/app.jar /app/app.jar

# Koyeb-friendly defaults. Override from the Koyeb dashboard as needed.
#
#  PORT        — Koyeb injects the port; application.yaml uses ${PORT:2700}
#  JAVA_OPTS   — sized for a ~1 GB instance; raise for larger
#  DB          — H2 file-based under /app/store (ephemeral unless a Koyeb
#                Volume is mounted). Point SPRING_DATASOURCE_URL at a
#                managed database for persistence.
ENV PORT=8080 \
    JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+UseContainerSupport -Djava.security.egd=file:/dev/./urandom" \
    SPRING_PROFILES_ACTIVE=production \
    SPRING_DATASOURCE_URL="jdbc:h2:file:/app/store/db/turingDB;DATABASE_TO_UPPER=false;CASE_INSENSITIVE_IDENTIFIERS=true" \
    SPRING_DATASOURCE_USERNAME=sa \
    SPRING_DATASOURCE_PASSWORD="" \
    SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver \
    SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.H2Dialect \
    TURING_ALLOWEDORIGINS="*" \
    TURING_OPEN_BROWSER=false

USER java

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD curl -fsS "http://localhost:${PORT}/actuator/health" || exit 1

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -Dlogging.config=classpath:logback-spring-console.xml -jar /app/app.jar"]
