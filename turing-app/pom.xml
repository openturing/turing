                <executions>
                    <!-- Install Node and pnpm together via the plugin's dedicated goal.
                         This sets up pnpm with proper bin symlinks so subprocesses
                         (like Turbo) can resolve it on PATH — unlike a manual
                         `npm install pnpm`, which only drops the package into
                         node_modules without a PATH entry. -->
                    <execution>
                        <id>install node and pnpm</id>
                        <goals>
                            <goal>install-node-and-pnpm</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>../frontend</workingDirectory>
                        </configuration>
                        <phase>generate-resources</phase>
                    </execution>
                    <execution>
                        <id>pnpm install</id>
                        <goals>
                            <goal>pnpm</goal>
                        </goals>
                        <configuration>
                            <arguments>install --frozen-lockfile=false</arguments>
                            <workingDirectory>../frontend</workingDirectory>
                        </configuration>
                        <phase>generate-resources</phase>
                    </execution>
                    <execution>
                        <id>pnpm build:app</id>
                        <goals>
                            <goal>pnpm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build:app</arguments>
                            <workingDirectory>../frontend</workingDirectory>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <nodeVersion>v26.3.1</nodeVersion>
                    <pnpmVersion>11.8.0</pnpmVersion>
                    <skip>${skip.npm}</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <skip>false</skip>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <!-- `-DskipUTs=true` skips unit tests (Surefire) but not
                         integration tests (Failsafe). -->
                    <skip>${skipUTs}</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.6</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    <testFailureIgnore>true</testFailureIgnore>
                    <!-- JaCoCo IT agent (set by jacoco prepare-agent-integration in
                         the root pom's `coverage` profile). Late @{} resolution so
                         it is empty/no-op when the profile is inactive. -->
                    <argLine>@{failsafeArgLine}</argLine>
                    <!--
                        BehavioralIT classes (real-LLM ITs gated by
                        OPENAI_API_KEY) are excluded from the default run so
                        every-PR CI doesn't burn API credits and JVMs aren't
                        slowed down by Spring contexts they'll skip on first
                        @BeforeAll anyway. Re-include them under -Pllm-it
                        (see profiles below) — that's the profile to use
                        for nightly / pre-release pipelines.
                    -->
                    <excludes>
                        <exclude>**/*BehavioralIT.java</exclude>
                        <!--
                            AgentEvalIT classes (T288 Agent-CI gate, real-LLM,
                            gated by OPENAI_API_KEY) are excluded from the
                            default run for the same reason as BehavioralIT.
                            Re-include them under -Pagent-eval (see profiles).
                        -->
                        <exclude>**/*AgentEvalIT.java</exclude>
                        <!--
                            NLFacetEvalIT classes (T407 NL→facet eval gate,
                            real-LLM + live index, gated by OPENAI_API_KEY) are
                            excluded from the default run for the same reason.
                            Re-include them under -Pnl-facet-eval (see profiles).
                        -->
                        <exclude>**/*NLFacetEvalIT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <version>3.22.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-project-info-reports-plugin</artifactId>
                <version>3.9.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pdf-plugin</artifactId>
                <version>1.6.2</version>
            </plugin>
            <plugin>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-maven-plugin</artifactId>
                <version>5.0.3</version>
                <configuration>
                    <propertyFile>liquibase.properties</propertyFile>
                    <diffChangeLogFile>src/main/resources/db/changelog/v2026.1_update.yaml</diffChangeLogFile>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.h2database</groupId>
                        <artifactId>h2</artifactId>
                        <version>2.4.240</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>
        </plugins>
    </reporting>

    <profiles>
        <!--
            llm-it: runs ONLY the real-LLM BehavioralIT classes — the ITs
            that gate on @EnabledIfEnvironmentVariable("OPENAI_API_KEY") and
            assert behavior of gpt-4o-mini against pinned prompts. Use this
            profile for nightly / pre-release pipelines:

                mvn verify -Pllm-it -pl turing-app -Dskip.npm=true

            Without OPENAI_API_KEY set, JUnit short-circuits each class with
            a "skipped" status — no API calls, no cost. With the key set,
            the pinned model versions in each test Javadoc determine which
            calls go out.

            The default failsafe configuration excludes *BehavioralIT.java
            (see the maven-failsafe-plugin block above), so this profile is
            additive only when explicitly activated.
        -->
        <profile>
            <id>llm-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/*BehavioralIT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            agent-eval: runs ONLY the Agent-CI eval ITs (*AgentEvalIT.java) —
            the T288 golden-set gate that replays cases through the real
            chat-flow engine and scores them with the bilingual LLM judge.
            Gated by @EnabledIfEnvironmentVariable("OPENAI_API_KEY"), so it
            short-circuits to "skipped" without the key (no cost). Use for
            nightly / PR gating, mirroring -Pllm-it (T242):

                mvn verify -Pagent-eval -pl turing-app -Dskip.npm=true

            The default failsafe configuration excludes *AgentEvalIT.java
            (see the maven-failsafe-plugin block above), so this profile is
            additive only when explicitly activated.
        -->
        <profile>
            <id>agent-eval</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/*AgentEvalIT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            nl-facet-eval: runs ONLY the NL→facet eval ITs (*NLFacetEvalIT.java) —
            the T407 end-to-end gate that provisions a catalog site+schema via the
            T382 manifest, indexes fixture docs, then drives the real
            TurLlmNLFacetParser and executes each parsed query against the live
            Lucene index. Gated by @EnabledIfEnvironmentVariable("OPENAI_API_KEY"),
            so it short-circuits to "skipped" without the key (no cost). Mirrors
            -Pagent-eval:

                mvn verify -Pnl-facet-eval -pl turing-app -Dskip.npm=true

            The default failsafe configuration excludes *NLFacetEvalIT.java
            (see the maven-failsafe-plugin block above), so this profile is
            additive only when explicitly activated.
        -->
        <profile>
            <id>nl-facet-eval</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/*NLFacetEvalIT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
