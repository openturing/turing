# ── Build outputs ────────────────────────────────────────────
/bin/
/build/
# T921 — every workspace's build output, by pattern. This used to be one
# anchored line per workspace, thirteen of them, and flow-dsl never got its
# own: 20 compiled files were tracked, and each build landed in the next
# commit. A list that must be extended per workspace is a list that misses one.
dist/
/target/
/backup/

# ── IDE & editor ─────────────────────────────────────────────
/.idea
/.classpath
/.settings
/.project
/.gradle/
.sts4-cache
.metals
.bloop
.sonar_lock
scripts/sonar/.sonar-token
.mtj.tmp/

# ── JVM crash logs ───────────────────────────────────────────
hs_err_pid*

# ── Package archives ────────────────────────────────────────
*.war
*.ear

# ── Node / pnpm ──────────────────────────────────────────────
node
node_modules/
/frontend/bin/
# Workspace uses pnpm — npm's package-lock is not authoritative and
# would drift from pnpm-lock.yaml if accidentally generated. Keep it ignored.
package-lock.json
# yarn, just in case
yarn.lock

# ── Maven flatten / shade ───────────────────────────────────
.flattened-pom.xml
dependency-reduced-pom.xml

# ── Runtime data & storage ──────────────────────────────────
/store/
/store.*
/logs/
/activemq-data
/models
/nashorn_code_cache
db-encrypted.properties

# ── Docker volumes ──────────────────────────────────────────
/volumes/mariadb/*
!/volumes/mariadb/.gitkeep
/volumes/turing/*
!/volumes/turing/.gitkeep

# ── Turing App ──────────────────────────────────────────────
/turing-app/export
turing-app/src/main/resources/public/index.html
turing-app/src/main/resources/public/favicon.ico

# ── Turing React ────────────────────────────────────────────
/turing-react/.__mf__temp

# ── Turing React SDK ────────────────────────────────────────

# ── Turing Marketplace (generated manifests, builds, exports) ──
turing-marketplace/*/app/public/turing-manifest.json
turing-marketplace/*/app/*.zip
turing-marketplace/*/export/*.zip

# ── GitHub Actions ──────────────────────────────────────────
/.github/appmod

# ── Python cache ────────────────────────────────────────────
__pycache__/
/turing-react/.mf
turing-react-sdk/debug-storybook.log
**/storybook-static/
/.github/modernize
/.turbo
/frontend/.turbo
frontend/apps/marketplace/space-missions/space-missions.zip
/frontend/apps/showcase/.turbo
frontend/apps/showcase/atlas-store.zip
