# ── Build outputs ────────────────────────────────────────────
/bin/
/build/
/target/
/dist/
/frontend/dist/
/backup/

# ── IDE & editor ─────────────────────────────────────────────
/.idea
/.classpath
/.settings
/.project
/.gradle/
.sts4-cache
.metals
.bloop
.sonar_lock
scripts/sonar/.sonar-token
.mtj.tmp/

# ── JVM crash logs ───────────────────────────────────────────
hs_err_pid*

# ── Package archives ────────────────────────────────────────
*.war
*.ear

# ── Node / pnpm ──────────────────────────────────────────────
node
node_modules/
/frontend/bin/
# Workspace uses pnpm — npm's package-lock is not authoritative and
# would drift from pnpm-lock.yaml if accidentally generated. Keep it ignored.
package-lock.json
# yarn, just in case
yarn.lock

# ── Maven flatten / shade ───────────────────────────────────
.flattened-pom.xml
dependency-reduced-pom.xml

# ── Runtime data & storage ──────────────────────────────────
/store/
/store.*
/logs/
/activemq-data
/models
/nashorn_code_cache
db-encrypted.properties

# ── Docker volumes ──────────────────────────────────────────
/volumes/mariadb/*
!/volumes/mariadb/.gitkeep
/volumes/turing/*
!/volumes/turing/.gitkeep

# ── Turing App ──────────────────────────────────────────────
/turing-app/export
turing-app/src/main/resources/public/index.html
turing-app/src/main/resources/public/favicon.ico

# ── Turing React ────────────────────────────────────────────
/turing-react/.__mf__temp

# ── Turing React SDK ────────────────────────────────────────
turing-react-sdk/dist

# ── Turing Marketplace (generated manifests, builds, exports) ──
