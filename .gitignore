# ── Build outputs ────────────────────────────────────────────
/bin/
/build/
/target/
/dist/
/backup/

# ── IDE & editor ─────────────────────────────────────────────
/.idea
/.classpath
/.settings
/.project
/.gradle/
/.claude
.sts4-cache
.metals
.bloop
.sonar_lock
.mtj.tmp/

# ── JVM crash logs ───────────────────────────────────────────
hs_err_pid*

# ── Package archives ────────────────────────────────────────
*.war
*.ear

# ── Node / npm ───────────────────────────────────────────────
node
node_modules/

# ── Maven flatten / shade ───────────────────────────────────
.flattened-pom.xml
dependency-reduced-pom.xml

# ── Runtime data & storage ──────────────────────────────────
/store/
/store.*
/logs/
/activemq-data
/models
/nashorn_code_cache
db-encrypted.properties

# ── Docker volumes ──────────────────────────────────────────
/volumes/mariadb/*
!/volumes/mariadb/.gitkeep
/volumes/turing/*
!/volumes/turing/.gitkeep

# ── Turing App ──────────────────────────────────────────────
/turing-app/export
turing-app/src/main/resources/public/index.html
turing-app/src/main/resources/public/favicon.ico

# ── Turing React ────────────────────────────────────────────
/turing-react/.__mf__temp

# ── Turing React SDK ────────────────────────────────────────
turing-react-sdk/dist

# ── Turing Marketplace (generated manifests, builds, exports) ──
turing-marketplace/*/app/public/turing-manifest.json
turing-marketplace/*/app/dist
turing-marketplace/*/app/*.zip
turing-marketplace/*/export/*.zip

# ── GitHub Actions ──────────────────────────────────────────
/.github/appmod

# ── Python cache ────────────────────────────────────────────
__pycache__/
/turing-react/.mf
turing-react-sdk/debug-storybook.log
