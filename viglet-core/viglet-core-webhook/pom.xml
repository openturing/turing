<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.viglet.core</groupId>
        <artifactId>viglet-core</artifactId>
        <version>2026.3.4</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>viglet-core-webhook</artifactId>
    <packaging>jar</packaging>
    <name>Viglet Core :: Webhook</name>
    <description>Outbound webhook dispatch (HMAC-SHA256 signing + retry/backoff) shared across Viglet products</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <!--
      T378 / Block Q — the outbound-webhook pattern re-implemented in two products
      (Turing's TurChatWebhookService dispatch + Shio's ShWebhookSigner /
      ShWebhookDispatcher): sign a request body with HMAC-SHA256 and deliver it
      asynchronously with a bounded retry/backoff loop, off the request thread.

      Intentionally zero runtime dependencies: the signer uses javax.crypto and
      the dispatcher uses the JDK HttpClient (java.net.http), so a product pulls
      nothing extra. Body serialization (Jackson, templating, …) and the secret
      store stay in the product — this module takes opaque byte[] bodies and an
      already-resolved (decrypted) signing secret.
    -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
