<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.viglet.core</groupId>
        <artifactId>viglet-core</artifactId>
        <version>2026.3.4</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>viglet-core-tenancy</artifactId>
    <packaging>jar</packaging>
    <name>Viglet Core :: Tenancy</name>
    <description>Persistence-agnostic multi-tenancy kernel (thread-bound tenant context, plain-column infra scoping, Hibernate @TenantId resolver, platform-admin) as a Spring Boot starter</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <!--
      T370 / Block Q — the tenancy kernel proven in Turing (Block J), lifted once
      it stabilized (after T372/T365/T366). Only the framework-level,
      persistence-agnostic primitives move here: the thread-bound tenant context,
      the plain-column scoping helper, the Hibernate discriminator resolver and
      the platform-admin privilege gate. The tenant-registry entities/tables, the
      request->tenant resolution filter and the lifecycle services stay in each
      product because they bind to that product's user/membership model
      (STRATEGY §XII / IMPROVEMENTS §XIV.8.8).

      Hibernate + spring-boot-hibernate are provided: the consuming product brings
      JPA, and the discriminator wiring only activates when those classes are on
      the classpath (@ConditionalOnClass). A product that wants only the context +
      scope helper can use them without JPA.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-hibernate</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
