{
  "name": "PedidoDePizza",
  "description": "Fluxo de atendimento para registrar pedidos de pizza, guiando o cliente do início ao fim.",
  "guardrailMethod": "LLM_JUDGE",
  "triggerDescription": "Use este fluxo quando o usuário quiser pedir uma pizza, fazer um pedido de delivery, ou perguntar sobre o cardápio para fazer pedido.",
