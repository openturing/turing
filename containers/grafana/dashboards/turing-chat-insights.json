{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "datasource", "uid": "grafana" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Customer-facing AI chat behavior — who's talking, what they're trying to accomplish, where the agent succeeds, where it abandons. Reads from the engine-agnostic /api/system/chat-analytics endpoints (backed by Mongo or Redis depending on turing.logging.engine).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "turing-chat-analytics" },
      "description": "Total chat sessions started in the period (each conversation = one row in the analytics store).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["sum"], "fields": "/^count$/", "values": false },
        "textMode": "value_and_name"
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "turing-chat-analytics" },
          "type": "json",
          "source": "url",
          "url": "http://host.docker.internal:2700/api/system/chat-analytics/aggregate",
          "url_options": { "method": "GET", "data": "" },
          "refId": "A",
          "format": "table",
          "root_selector": "",
          "columns": [
            { "selector": "bucket", "text": "outcome", "type": "string" },
            { "selector": "count",  "text": "count",   "type": "number" }
          ],
          "filters": [],
          "parser": "backend",
          "url_query_params": [
            { "key": "from", "value": "${__from:date:iso}" },
            { "key": "to",   "value": "${__to:date:iso}" },
            { "key": "by",   "value": "outcome" },
            { "key": "limit", "value": "20" }
          ]
        }
      ],
      "title": "Total chat sessions",
      "type": "stat"
    },
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "turing-chat-analytics" },
      "description": "How conversations end. COMPLETED = flow reached an end node. ABANDONED = user reset the conversation mid-flow. IN_PROGRESS = still open. ERROR = server-side failure.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "COMPLETED" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "ABANDONED" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "IN_PROGRESS" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          },
          {
            "matcher": { "id": "byName", "options": "ERROR" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "displayLabels": ["percent"],
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "values": ["value"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "turing-chat-analytics" },
          "type": "json",
          "source": "url",
          "url": "http://host.docker.internal:2700/api/system/chat-analytics/aggregate",
          "url_options": { "method": "GET", "data": "" },
          "refId": "A",
          "format": "table",
          "root_selector": "",
          "columns": [
            { "selector": "bucket", "text": "outcome", "type": "string" },
            { "selector": "count",  "text": "count",   "type": "number" }
          ],
          "filters": [],
          "parser": "backend",
          "url_query_params": [
            { "key": "from", "value": "${__from:date:iso}" },
            { "key": "to",   "value": "${__to:date:iso}" },
            { "key": "by",   "value": "outcome" }
          ]
        }
      ],
      "title": "Outcome distribution",
      "type": "piechart"
