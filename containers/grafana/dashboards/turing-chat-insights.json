    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "turing-chat-analytics" },
      "description": "Most recent chat sessions with all aggregates. The first user message gives you the gist of what each conversation was about — useful for spot-checking the analytics pipeline and for quick UX investigation.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true,
            "inspect": true
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "outcome" },
            "properties": [
              {
                "id": "mappings",
                "value": [
