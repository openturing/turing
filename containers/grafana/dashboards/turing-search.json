{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "datasource", "uid": "grafana" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Turing ES — SN search pipeline (turing.search.pipeline) + search engine calls (turing.search.calls) + snapshot cache outcomes.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "turing-prometheus" },
      "description": "Total search requests per second, by status (success/error).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "turing-prometheus" },
          "expr": "sum by (status) (rate(turing_search_pipeline_seconds_count{stage=\"search.total\"}[1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "title": "Search rate (req/s)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "turing-prometheus" },
      "description": "Average end-to-end search latency over the last 5 minutes (sum / count of the search.total stage).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.2 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "turing-prometheus" },
          "expr": "sum(rate(turing_search_pipeline_seconds_sum{stage=\"search.total\"}[5m])) / sum(rate(turing_search_pipeline_seconds_count{stage=\"search.total\"}[5m]))",
          "legendFormat": "avg",
          "refId": "A"
        }
      ],
      "title": "Avg search latency",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "turing-prometheus" },
      "description": "Snapshot cache hit ratio. A miss means the request had to materialize the snapshot from the database; an evict means a write to one of the snapshot-tracked entities cleared the cache.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "turing-prometheus" },
          "expr": "1 - (sum(rate(turing_search_snapshot_cache_total{outcome=\"miss\"}[5m])) / clamp_min(sum(rate(turing_search_pipeline_seconds_count{stage=\"search.total\"}[5m])), 1))",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ],
      "title": "Snapshot hit ratio",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "turing-prometheus" },
      "description": "Snapshot cache evictions per minute. Frequent evictions indicate frequent writes to TurSNSite, TurSNSiteFieldExt, TurSNSiteCustomFacet, TurSNSiteFieldExtFacet, TurSNSiteLocale or TurSNSiteCustomSort.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "turing-prometheus" },
          "expr": "sum(rate(turing_search_snapshot_cache_total{outcome=\"evict\"}[1m]))",
          "legendFormat": "evictions/s",
          "refId": "A"
        }
      ],
      "title": "Snapshot evictions",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "turing-prometheus" },
      "description": "Average duration of each pipeline stage. The sum across stages should approximate the search.total stage; the difference reveals work outside the instrumented stages (e.g. plugin call to Solr/Lucene).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 25,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "turing-prometheus" },
          "expr": "sum by (stage) (rate(turing_search_pipeline_seconds_sum[1m])) / clamp_min(sum by (stage) (rate(turing_search_pipeline_seconds_count[1m])), 0.0001)",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "title": "Pipeline avg latency by stage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "turing-prometheus" },
      "description": "p95 latency of the search engine plugin call (Solr/Lucene). Requires turing.search.calls histogram-percentiles which is enabled by default in application.yaml.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "turing-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, engine, operation) (rate(turing_search_calls_seconds_bucket[5m])))",
          "legendFormat": "{{engine}} / {{operation}}",
          "refId": "A"
        }
      ],
      "title": "Search engine p95 (turing.search.calls)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "turing-prometheus" },
      "description": "Snapshot cache outcomes per second — hits are inferred (search.total - miss), misses come from the @Cacheable build path, evicts come from the JPA entity listener.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "turing-prometheus" },
          "expr": "sum by (outcome) (rate(turing_search_snapshot_cache_total[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Snapshot cache outcomes",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["turing", "search", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
