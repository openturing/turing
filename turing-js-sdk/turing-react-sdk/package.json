{
  "name": "@viglet/turing-react-sdk",
  "version": "2026.2.5",
  "description": "React SDK for Viglet Turing ES - Headless hooks + UI components for enterprise search",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build:deps": "npm ci --no-audit --no-fund || npm install --no-audit --no-fund",
    "build:run": "npx tsc",
    "build": "npm run build:deps && npm run build:run",
    "dev": "tsc --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "turing",
    "react",
    "search",
    "semantic-navigation",
    "headless",
    "hooks",
    "enterprise-search",
    "sdk"
  ],
  "author": "Viglet",
  "license": "Apache-2.0",
  "peerDependencies": {
    "axios": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.17",
    "@storybook/addon-links": "^8.6.17",
    "@storybook/blocks": "^8.6.17",
    "@storybook/react": "^8.6.17",
    "@storybook/react-vite": "^8.6.17",
    "@storybook/test": "^8.6.17",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "^1.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0",
    "storybook": "^8.6.17",
    "typescript": "^5.0.0",
    "vite": "^6.4.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openviglet/turing.git",
    "directory": "turing-js-sdk/turing-react-sdk"
  },
  "files": [
    "dist/**/*"
  ]
}
