{
  "name": "@viglet/turing-sdk",
  "version": "2026.2.8",
  "description": "TypeScript SDK for Turing Semantic Navigation Search API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build:deps": "npm ci --no-audit --no-fund || npm install --no-audit --no-fund",
    "build:run": "node build.js",
    "build": "npm run build:deps && npm run build:run",
    "dev": "tsc --watch",
    "clean": "",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "turing",
    "search",
    "semantic-navigation",
    "typescript",
    "sdk",
    "rest-api"
  ],
  "author": "Viglet",
  "license": "Apache-2.0",
  "dependencies": {
    "axios": "^1.11.0",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openviglet/turing.git",
    "directory": "turing-js-sdk/js-sdk-lib"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  }
}
