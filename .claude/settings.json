{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__roadkeep",
      "mcp__plugin_roadkeep_roadkeep",
      "Edit(/.claude/skills/turing-roadmap-docs/**)",
      "Bash(cd \"D:/Git/viglet/turing/2026.3\" && sed -n '/## Propagating to end-user documentation/,/^## /p' .claude/skills/turing-roadmap-docs/SKILL.md | head -45)",
      "Bash(cd \"D:/Git/viglet/turing/2026.3\" && sed -n '/^5\\\\. \\\\*\\\\*Product name/,/^---/p' .claude/skills/turing-roadmap-docs/SKILL.md | tail -12)",
      "Edit(/.claude/skills/turing-bento-ui/**)"
    ],
    "additionalDirectories": [
      "D:\\Git\\viglet\\turing\\2026.3\\.claude\\skills\\turing-roadmap-docs"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/roadkeep-launch.py\" guard",
            "timeout": 70
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|NotebookEdit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/roadkeep-launch.py\" guard",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/roadkeep-launch.py\" guard",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "roadkeep@alegauss": true
  },
  "extraKnownMarketplaces": {
    "alegauss": {
      "source": {
        "source": "github",
        "repo": "alegauss/roadkeep"
      }
    }
  }
}
